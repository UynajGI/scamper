#!/usr/bin/env bash
# Scuttle pre-push hook.
#
# Runs the full test suite on affected crates before pushing. Reads push
# metadata from stdin (lines of "<local ref> <local sha> <remote ref> <remote sha>").
#
# Setup:    git config core.hooksPath .githooks
# Skip all: SKIP=all git push    (or HOOK_SKIP=1)
# Skip:     SKIP=test git push
# Skip fast: PUSH_HOOK_SKIP=1 git push   (for emergencies only)

set -euo pipefail

# shellcheck source=_common.sh
source "$(dirname "$0")/_common.sh"

case "${HOOK_SKIP:-}" in
    1|true|yes) exit 0 ;;
esac
if ! hook_skip "all"; then :; else exit 0; fi
case "${PUSH_HOOK_SKIP:-}" in
    1|true|yes) exit 0 ;;
esac

# --- decide what changed ---------------------------------------------------
# Use the range of commits being pushed vs. the remote tip. Falls back to
# the pushed commits' files; if that's empty (e.g. first push of a branch),
# test the whole workspace to be safe.
REMOTE_SHA=""
while read -r _local_ref _local_sha _remote_ref remote_sha; do
    # zero sha means branch deletion — nothing to test.
    if [ "$_local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi
    # Track the remote tip; multiple refs pushed → take the union by testing
    # the workspace (rare, keeps correctness simple).
    REMOTE_SHA="$remote_sha"
    if [ -n "${SEEN_REF:-}" ]; then
        MULTI=1
    fi
    SEEN_REF=1
done

# Branch deletion-only push → nothing to verify.
[ -z "${SEEN_REF:-}" ] && exit 0

cd "$(repo_root)"

# Collect .rs files touched in the pushed range. If remote_sha is all zeros
# (new branch), diff against the default branch's merge-base with HEAD.
ZERO="0000000000000000000000000000000000000000"
if [ -z "$REMOTE_SHA" ] || [ "$REMOTE_SHA" = "$ZERO" ]; then
    BASE="$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD origin/master 2>/dev/null || echo "")"
    [ -z "$BASE" ] && BASE="HEAD~10"
    RANGE="${BASE}..HEAD"
else
    RANGE="${REMOTE_SHA}..HEAD"
fi

PUSHED_RS="$(git diff --name-only --diff-filter=ACMR "$RANGE" -- '*.rs' || true)"

if [ -z "${MULTI:-}" ] && [ -n "$PUSHED_RS" ]; then
    # Derive affected crates from the pushed file set.
    crates=""
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        case "$f" in
            Carlo.rs/*) crates="${crates}carlo-rs " ;;
            QMC.rs/*)   crates="${crates}qmc-rs " ;;
            CMC.rs/*)   crates="${crates}cmc-rs " ;;
        esac
    done <<EOF
$PUSHED_RS
EOF
else
    crates=""
fi

# Dedupe.
seen=""; PKG_FLAGS=""
for c in $crates; do
    case " $seen " in
        *" $c "*) ;;
        *) seen="$seen $c"; PKG_FLAGS="${PKG_FLAGS}-p ${c} " ;;
    esac
done

if [ -z "$PKG_FLAGS" ]; then
    PKG_FLAGS="--workspace"
    SCOPE="workspace"
else
    SCOPE="(crates: $(echo "$PKG_FLAGS" | sed 's/-p //g'))"
fi

# --- run tests -------------------------------------------------------------
if ! hook_skip "test"; then
    hook_header "cargo test  $SCOPE"
    if ! cargo test $PKG_FLAGS; then
        hook_fail "cargo test failed. Push aborted. Fix tests or use SKIP=test git push."
    fi
    hook_pass "tests"
fi

hook_pass "pre-push"
