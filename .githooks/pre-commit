#!/usr/bin/env bash
# Scuttle pre-commit hook.
#
# Runs cheap checks on staged Rust files (affected crates only):
#   1. cargo fmt --check   — formatting
#   2. cargo clippy        — lints (-D warnings)
#
# Heavy work (cargo test) lives in pre-push so `git commit` stays fast.
#
# Setup:    git config core.hooksPath .githooks
# Skip all: SKIP=all git commit        (or HOOK_SKIP=1)
# Skip one: SKIP=clippy git commit
#
# If anything is staged but fails fmt-check, the hook exits non-zero and the
# commit is aborted. Fix with `cargo fmt && git add -u`.

set -euo pipefail

# shellcheck source=_common.sh
source "$(dirname "$0")/_common.sh"

# --- short-circuit ---------------------------------------------------------
case "${HOOK_SKIP:-}" in
    1|true|yes) exit 0 ;;
esac
if ! hook_skip "all"; then :; else exit 0; fi

# shellcheck source=_common.sh
source "$(dirname "$0")/_common.sh"

# No Rust staged → nothing to do (let non-Rust commits through untouched).
if [ -z "$(staged_files)" ]; then
    exit 0
fi

PKG_FLAGS="$(affected_crates)"
# PKG_FLAGS may be empty if the .rs files are outside the known crate dirs
# (e.g. benches under target/). Fall back to --workspace for safety.
if [ -z "$PKG_FLAGS" ]; then
    PKG_FLAGS="--workspace"
    SCOPE="workspace"
else
    SCOPE="(crates: $(echo "$PKG_FLAGS" | sed 's/-p //g'))"
fi

cd "$(repo_root)"

# --- 1. format check -------------------------------------------------------
if ! hook_skip "fmt"; then
    hook_header "cargo fmt --check  $SCOPE"
    # fmt --check has no -p filter; scope is informational only.
    if ! cargo fmt --check; then
        hook_fail "cargo fmt --check failed. Run \`cargo fmt\` then re-stage."
    fi
    hook_pass "fmt"
fi

# --- 2. clippy -------------------------------------------------------------
if ! hook_skip "clippy"; then
    hook_header "cargo clippy --all-targets  $SCOPE"
    if ! cargo clippy --all-targets $PKG_FLAGS -- -D warnings; then
        hook_fail "clippy found issues (treated as errors via -D warnings)."
    fi
    hook_pass "clippy"
fi

hook_pass "pre-commit"
