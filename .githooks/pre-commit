#!/usr/bin/env bash
set -euo pipefail

# Scuttle pre-commit hook — format check + clippy + test

CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
RUST_FILES=$(echo "$CHANGED_FILES" | grep '\.rs$' || true)

if [ -z "$RUST_FILES" ]; then
    exit 0
fi

# Collect affected crates (deduplicated via sort -u)
CRATES=$(for f in $CHANGED_FILES; do
    case "$f" in
        Carlo.rs/*) echo "carlo-rs" ;;
        QMC.rs/*)   echo "qmc-rs" ;;
        CMC.rs/*)   echo "cmc-rs" ;;
    esac
done | sort -u)

if [ -z "$CRATES" ]; then
    exit 0
fi

# Build -p flags
PKG_FLAGS=""
for c in $CRATES; do
    PKG_FLAGS="$PKG_FLAGS -p $c"
done

echo "==> cargo clippy --all-targets ${PKG_FLAGS} -- -D warnings"
cargo clippy --all-targets ${PKG_FLAGS} -- -D warnings

echo "==> cargo test ${PKG_FLAGS}"
cargo test ${PKG_FLAGS}

echo "==> pre-commit OK"
